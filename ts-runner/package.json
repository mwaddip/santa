{
  "name": "santa-ts-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Dasher — SANTA eval-tier conformance runner over @ergots/ergoscript",
  "type": "module",
  "bin": { "runner": "./dist/runner.js" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ergots/avltree": "file:./ergots-impl/packages/avltree",
    "@ergots/ergoscript": "file:./ergots-impl/packages/ergoscript",
    "@ergots/scorex": "file:./ergots-impl/packages/scorex",
    "@ergots/transaction": "file:./ergots-impl/packages/transaction"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": { "node": ">=20" }
}
