# sbt / Scala build artifacts
target/
project/target/
project/project/
.bsp/
.bloop/
.metals/

# IDE / OS
.idea/
*.iml
.DS_Store
*.swp

# logs / scratch
*.log

# Local scratch dir — research artifacts, extracted reference sources, session
# notes. Persists across sessions; never committed. (Repo-root tmp/, not system /tmp.)
tmp/

# Python — schema-validator gate (schema/validate.py). Local-only; recreate via:
#   python3 -m venv .venv && .venv/bin/pip install jsonschema referencing
.venv/

# Conformance impl cache — ./conform clones each runner's `impl` checkout here
# (.santa/impl/<runner>/<repo>); a build artifact, regenerated on demand.
.santa/
