# sbt / Scala build artifacts
target/
project/target/
project/project/
.bsp/
.bloop/
.metals/
# sbt on JDK 9+ exports the JDK's runtime here (rt.jar), one directory per JDK.
jvm-blesser/java9-rt-ext-*/

# IDE / OS
.idea/
*.iml
.DS_Store
*.swp

# logs / scratch
*.log

# Local scratch dir — research artifacts, extracted reference sources, session
# notes. Persists across sessions; never committed. (Repo-root tmp/, not system /tmp.)
tmp/

# Obsolete pre-rust python venv / caches (SANTA's tooling is now the tools/ rust workspace —
# conform + validate + santa-check). Kept ignored for any local leftover; safe to delete.
.venv/
__pycache__/

# Conformance workspaces — ./conform puts each runner's impl checkout + actuals
# under .santa/<runner>/ (self-contained, regenerated; --clean / rm -rf resets).
.santa/

# Build symlink the blitzen runners' santa-run creates: the fixed Cargo path-dep
# ../sigma-rust -> the per-instance .santa/<runner>/sigma-rust checkout. Regenerated
# every run; the last runner wins. Not a runner dir (no runner.json), so ./conform skips it.
runners/sigma-rust

# The same for vixen's santa-run: runners/ergo -> .santa/vixen/ergo.
runners/ergo

# Generated scoreboard output — regenerated by ./scoreboard / CI; not committed.
/site/

# Local-only. Only SANTA's code and its docs are published; these stay in the working
# tree: the umbrella spec and the bootstrap brainstorm, the design specs, the findings
# (write-ups, and the captured chain data some blessers read), the cross-session
# prompts, and the JVM spikes.
/SPEC.md
/BOOTSTRAP.md
docs/specs/
docs/findings/
prompts/
jvm-blesser/src/test/*/santa/spike/
