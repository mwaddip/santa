#!/usr/bin/env bash
# santa-run <impl-path> <vectors-dir> <out-dir>  — Rudolph (JVM reference runner).
# impl-path ($1) is ignored: Rudolph self-contains sigma-state 6.0.3 via sbt. One JVM
# invocation processes the whole dir (Runner dir-mode).
#
# Self-provision the toolchain (presence-as-state: runners/rudolph/mise.toml) — re-exec
# once under `mise exec` so java + sbt are on PATH for the sbt build under jvm-blesser/.
# The orchestrator stays toolchain-agnostic; `mise` on PATH is the one bootstrap dep;
# santa-run trusts its own co-located config (see runner-integration.md).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "${SANTA_MISE_ACTIVE:-}" ]; then
  mise trust "$here/mise.toml" >/dev/null
  mise --cd "$here" install
  exec env SANTA_MISE_ACTIVE=1 mise --cd "$here" exec -- "$0" "$@"
fi
# --- toolchain (java + sbt) now on PATH ---
VECTORS="$(realpath "$2")"
OUT="$(realpath -m "$3")"; mkdir -p "$OUT"
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"   # runners/rudolph -> repo root
(cd "$ROOT/jvm-blesser" && sbt --batch "runMain santa.runner.Runner $VECTORS $OUT")
