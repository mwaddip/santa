#!/usr/bin/env bash
# santa-pr [--runner-dir <dir>] [--label <label>] <impl> <base-ref> [<head-ref>] — SANTA's PR check: an
# implementation's own runner, a base and a head, the delta.
#
# The runner is the implementation's: <dir> of its checkout (default santa) holds its runner.json and santa-run, and
# SANTA has no entry for it (runner-integration §6a). Grades it at <impl>'s <base-ref>, then at <head-ref>, or without
# one at the working tree of <impl> in place (uncommitted edits included), each ref with its own copy of the runner,
# both on THIS SANTA checkout's vectors, and compares the two with santa-delta into .santa/pr/: base.json and
# head.json (conform's results), comment.md, summary.md, delta.json. <label> names the runner in the comment (default
# the repo's name).
#
# <impl> is a local checkout, or with a <head-ref> any url git clones. A ref is a branch, tag or commit of it; a
# commit sha is the unambiguous choice for a base (a PR's base is often a commit only `origin/main` holds). Only the
# implementation's runner runs: rudolph is not needed, the vectors carry its blessed expectations. Each run rewrites
# .santa/results.json, as any conform run does. The same bootstrap as ./conform (mise, git, a systemd user manager on
# cgroup v2, so Linux only); a CI workflow calls this with the PR's head ref and posts comment.md.
set -euo pipefail
d="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${SANTA_TOOLS_MISE:-}" ]; then
  mise trust "$d/tools/mise.toml" >/dev/null
  mise --cd "$d/tools" install
  # Re-exec under the tools' mise with an ABSOLUTE self-path (see ./conform).
  exec env SANTA_TOOLS_MISE=1 mise --cd "$d/tools" exec -- "$d/$(basename "$0")" "$@"
fi
usage() {
  echo "usage: ./santa-pr [--runner-dir <dir>] [--label <label>] <impl> <base-ref> [<head-ref>]" >&2
  exit 2
}
dir=santa label=
while [ $# -gt 0 ]; do
  case $1 in
    --runner-dir) [ $# -ge 2 ] || usage; dir=$2; shift 2 ;;
    --label) [ $# -ge 2 ] || usage; label=$2; shift 2 ;;
    -*) echo "santa-pr: unknown option $1" >&2; usage ;;
    *) break ;;
  esac
done
if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  usage
fi
impl=$1 base=$2 head=${3:-}
if [ -d "$impl" ]; then
  impl="$(cd "$impl" && pwd)" # conform clones it from its own cache dir: name it absolutely
elif [ -z "$head" ]; then
  echo "santa-pr: without a <head-ref>, <impl> must be a local checkout (its working tree is the head)" >&2
  exit 2
fi
runner=(--runner-dir "$dir")
if [ -n "$label" ]; then
  runner+=(--label "$label")
fi
out="$d/.santa/pr"
rm -rf "$out"
mkdir -p "$out"

"$d/conform" --hosted "$impl#$base" "${runner[@]}"
cp "$d/.santa/results.json" "$out/base.json"
if [ -n "$head" ]; then
  "$d/conform" --hosted "$impl#$head" "${runner[@]}"
else
  "$d/conform" --hosted "$impl" "${runner[@]}"
fi
cp "$d/.santa/results.json" "$out/head.json"

cargo run --manifest-path "$d/tools/Cargo.toml" -p santa-delta -q -- "$out/base.json" "$out/head.json" "$out"
echo "santa-pr: $out/comment.md (summary.md and delta.json beside it)" >&2
