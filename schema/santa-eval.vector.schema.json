{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mwaddip/santa/schema/santa-eval.vector.schema.json",
  "title": "SANTA eval-tier vector",
  "description": "A committed conformance vector for the eval tier (v1 closed-tree · v2 input · v3 per-input extensions · v4 SELF registers + var1 · v5 top-level ContextExtension key-domain · v6-fullctx full-context envelope). Normative companion to docs/contract/runner-contract.md.",
  "type": "object",
  "required": ["schema", "op", "blessed_by", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "description": "Tier + version discriminator.",
      "enum": ["santa-eval/v1", "santa-eval/v2", "santa-eval/v3", "santa-eval/v4", "santa-eval/v5", "santa-eval/v6-fullctx"]
    },
    "op": {
      "description": "The operation / property name this vector covers.",
      "type": "string",
      "minLength": 1
    },
    "blessed_by": {
      "description": "Identifier of the oracle that produced the expected values.",
      "type": "string",
      "minLength": 1
    },
    "source": {
      "description": "Provenance of the cases (e.g. sigma-state:LanguageSpecificationV6).",
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "allOf": [
    {
      "$comment": "santa-eval/v2 entries MUST carry an input; santa-eval/v1 entries MUST NOT. Enforced here because the schema discriminator and entries are both visible at the top level.",
      "if": {
        "properties": { "schema": { "const": "santa-eval/v2" } },
        "required": ["schema"]
      },
      "then": {
        "$comment": "v2 carries `source`; every entry has an `input` and no `inputs`.",
        "required": ["source"],
        "properties": {
          "entries": { "items": {
            "required": ["input"],
            "not": { "required": ["inputs"] }
          } }
        }
      },
      "else": {
        "$comment": "Not v2: v1/v3/v4 (v4 also uses `input`; v1/v3 must not use it). Prohibit `input` only for v1/v3 entries; v4 is handled by its own allOf element.",
        "if": {
          "properties": { "schema": { "enum": ["santa-eval/v1", "santa-eval/v3"] } },
          "required": ["schema"]
        },
        "then": {
          "properties": {
            "entries": { "items": { "not": { "required": ["input"] } } }
          }
        }
      }
    },
    {
      "$comment": "santa-eval/v3 carries `source`; every entry has `inputs` (per-input extensions) and NO single `input`.",
      "if": { "properties": { "schema": { "const": "santa-eval/v3" } }, "required": ["schema"] },
      "then": {
        "required": ["source"],
        "properties": { "entries": { "items": {
          "required": ["inputs"],
          "not": { "required": ["input"] }
        } } }
      }
    },
    {
      "$comment": "santa-eval/v4 carries `source`; every entry has `input` (var 1 binding) + `selfRegisters` (non-mandatory SELF box registers, id -> SValue JSON).",
      "if": { "properties": { "schema": { "const": "santa-eval/v4" } }, "required": ["schema"] },
      "then": {
        "required": ["source"],
        "properties": { "entries": { "items": {
          "required": ["input", "selfRegisters"]
        } } }
      }
    },
    {
      "$comment": "santa-eval/v5 carries `source`; every entry has `extension` (the top-level self ContextExtension, key -> SValue) and none of input/inputs/selfRegisters.",
      "if": { "properties": { "schema": { "const": "santa-eval/v5" } }, "required": ["schema"] },
      "then": {
        "required": ["source"],
        "properties": { "entries": { "items": {
          "required": ["extension"],
          "allOf": [
            { "not": { "required": ["input"] } },
            { "not": { "required": ["inputs"] } },
            { "not": { "required": ["selfRegisters"] } }
          ]
        } } }
      }
    },
    {
      "$comment": "santa-eval/v6-fullctx carries `source`; every entry has a full `context` envelope and none of input/inputs/selfRegisters/extension (the extension lives inside context).",
      "if": { "properties": { "schema": { "const": "santa-eval/v6-fullctx" } }, "required": ["schema"] },
      "then": {
        "required": ["source"],
        "properties": { "entries": { "items": {
          "required": ["context"],
          "allOf": [
            { "not": { "required": ["input"] } },
            { "not": { "required": ["inputs"] } },
            { "not": { "required": ["selfRegisters"] } },
            { "not": { "required": ["extension"] } }
          ]
        } } }
      }
    },
    {
      "$comment": "santa-eval/v1 entries carry neither `input` nor `inputs`.",
      "if": { "properties": { "schema": { "const": "santa-eval/v1" } }, "required": ["schema"] },
      "then": {
        "properties": { "entries": { "items": {
          "allOf": [ { "not": { "required": ["input"] } }, { "not": { "required": ["inputs"] } } ]
        } } }
      }
    }
  ],
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["name", "tree_bytes_hex", "version", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Unique-within-vector entry key (blesser appends #<index>). Runners key actuals by this.",
          "type": "string",
          "minLength": 1
        },
        "script": {
          "description": "Optional human-readable source of the function/op (informational).",
          "type": "string"
        },
        "tree_bytes_hex": {
          "description": "Serialized ErgoTree as lower-case hex. v2: a function tree A->B; v1: a closed tree.",
          "$ref": "#/$defs/hex"
        },
        "input": {
          "description": "The input SValue, bound to context var 1 at eval time. REQUIRED for santa-eval/v2 and santa-eval/v4, ABSENT for santa-eval/v1 (enforced at the top level, where the schema discriminator is visible).",
          "$ref": "#/$defs/svalue"
        },
        "selfRegisters": {
          "description": "santa-eval/v4: non-mandatory SELF box registers, keyed by register id (0-based integer as string, valid: 4-9). Values are SValue JSON.",
          "type": "object",
          "propertyNames": { "pattern": "^[4-9]$" },
          "additionalProperties": { "$ref": "#/$defs/svalue" }
        },
        "inputs": {
          "description": "santa-eval/v3: per-spending-tx-input ContextExtensions, in input order. Read by getVarFromInput.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["extension"],
            "additionalProperties": false,
            "properties": {
              "extension": {
                "type": "object",
                "propertyNames": { "pattern": "^(0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" },
                "additionalProperties": { "$ref": "#/$defs/svalue" }
              }
            }
          }
        },
        "extension": {
          "description": "santa-eval/v5: the SELF box's TOP-LEVEL ContextExtension (the source toSigmaContext builds the contextVars array from), keyed by the unsigned wire byte 0..255. A key >= 128 is a signed-negative Byte that crashes context construction before any bytecode.",
          "type": "object",
          "propertyNames": { "pattern": "^(0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" },
          "additionalProperties": { "$ref": "#/$defs/svalue" }
        },
        "context": { "$ref": "#/$defs/fullCtx" },
        "provenance": {
          "description": "santa-eval/v6-fullctx: capture origin (informational, not graded).",
          "type": "object",
          "additionalProperties": true
        },
        "version": { "$ref": "#/$defs/version" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "fullCtx": {
      "description": "santa-eval/v6-fullctx: the full ErgoLikeContext envelope reconstructed by EvalCore.evalFullContext. Boxes/headers are lower-case hex of their canonical serializations; pre_header_hex is the PreHeader sub-encoding.",
      "type": "object",
      "required": ["self_index", "inputs", "data_inputs", "outputs", "headers", "pre_header_hex", "height"],
      "additionalProperties": false,
      "properties": {
        "self_index": { "type": "integer", "minimum": 0 },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/hex" }, "minItems": 1 },
        "data_inputs": { "type": "array", "items": { "$ref": "#/$defs/hex" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/hex" } },
        "headers": { "type": "array", "items": { "$ref": "#/$defs/hex" } },
        "pre_header_hex": { "$ref": "#/$defs/hex" },
        "height": { "type": "integer", "minimum": 0 },
        "extension": {
          "description": "Legacy SELF-only top-level extension (fallback when input_extensions absent), key 0..255 -> SValue.",
          "type": "object",
          "propertyNames": { "pattern": "^(0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" },
          "additionalProperties": { "$ref": "#/$defs/svalue" }
        },
        "input_extensions": {
          "description": "Per-input ContextExtensions in input order (authoritative when present); index i = input i's extension.",
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": { "pattern": "^(0|[1-9][0-9]?|1[0-9][0-9]|2[0-4][0-9]|25[0-5])$" },
            "additionalProperties": { "$ref": "#/$defs/svalue" }
          }
        },
        "last_block_utxo_root_hex": {
          "description": "Optional explicit lastBlockUtxoRoot override; absent => derived from headers[0].stateRoot.",
          "$ref": "#/$defs/hex"
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["activated", "ergoTree"],
      "additionalProperties": false,
      "properties": {
        "activated": { "type": "integer", "minimum": 0, "maximum": 127 },
        "ergoTree": { "type": "integer", "minimum": 0, "maximum": 127 }
      }
    },
    "expected": {
      "description": "The blessed result. On success: value (SValue) + cost (number) + error null. On failure: value null + cost null + error 'errored'.",
      "type": "object",
      "required": ["value", "cost", "error"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "oneOf": [{ "$ref": "#/$defs/svalue" }, { "type": "null" }]
        },
        "cost": {
          "description": "Raw JIT eval cost as a bare JSON number (bounded by the block cost limit; NOT a string). Null iff errored.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "error": {
          "description": "Coarse outcome flag: null on success, 'errored' on any failure. No eval-tier taxonomy.",
          "enum": [null, "errored"]
        }
      },
      "allOf": [
        {
          "$comment": "errored => value and cost are null; success => error null and value present.",
          "if": { "properties": { "error": { "const": "errored" } }, "required": ["error"] },
          "then": {
            "properties": {
              "value": { "type": "null" },
              "cost": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "error": { "type": "null" },
              "cost": { "type": "integer", "minimum": 0 }
            },
            "required": ["value"],
            "not": { "properties": { "value": { "type": "null" } } }
          }
        }
      ]
    },
    "hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$",
      "$comment": "lower-case hex, even length (whole bytes)."
    },
    "svalue": {
      "description": "Canonical SValue encoding (see runner-contract.md §4). The Int-as-number / Long-as-string asymmetry is intentional and enforced here.",
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "Boolean" },
            "value": { "type": "boolean" }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Byte" },
            "value": { "type": "integer", "minimum": -128, "maximum": 127 }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Short" },
            "value": { "type": "integer", "minimum": -32768, "maximum": 32767 }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Int" },
            "value": {
              "$comment": "Range deliberately NOT bounded to int32. svalue is shared by the vector (expected) and actuals schemas; ACTUALS must be able to faithfully record an out-of-canonical-range divergence (e.g. a runner whose `>>> 0` yields a u32 like 2147483649 where the JVM wraps to a negative int32) so it grades as a value-coal rather than failing schema validation — runner-contract.md §3 'faithful outcomes / make the harness total'. EXPECTED stays canonical int32 by blesser construction (Scala Int; re-verified by EvalConformanceTest). The Int-as-number / Long-as-string asymmetry (§4) is unchanged — Int is still a bare JSON number.",
              "type": "integer"
            }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Long" },
            "value": { "type": "string", "pattern": "^-?[0-9]+$" }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "BigInt" },
            "value": { "type": "string", "pattern": "^-?[0-9]+$" }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "UnsignedBigInt" },
            "value": { "type": "string", "pattern": "^[0-9]+$" }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "GroupElement" },
            "bytes_hex": { "$ref": "#/$defs/hex" }
          },
          "required": ["kind", "bytes_hex"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "SigmaProp" },
            "raw_hex": { "$ref": "#/$defs/hex" }
          },
          "required": ["kind", "raw_hex"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Box" },
            "bytes_hex": { "$ref": "#/$defs/hex" }
          },
          "required": ["kind", "bytes_hex"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Header" },
            "bytes_hex": { "$ref": "#/$defs/hex" }
          },
          "required": ["kind", "bytes_hex"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "AvlTree" },
            "bytes_hex": { "$ref": "#/$defs/hex" }
          },
          "required": ["kind", "bytes_hex"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Coll" },
            "elem": { "$ref": "#/$defs/stype" },
            "items": { "type": "array", "items": { "$ref": "#/$defs/svalue" } }
          },
          "required": ["kind", "elem", "items"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Coll[Byte]" },
            "value_hex": { "$ref": "#/$defs/hex" }
          },
          "required": ["kind", "value_hex"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Tuple" },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/svalue" }
            }
          },
          "required": ["kind", "items"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "Option" },
            "value": {
              "oneOf": [{ "$ref": "#/$defs/svalue" }, { "type": "null" }]
            }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        }
      ]
    },
    "stype": {
      "description": "Canonical SType tag (see runner-contract.md §4).",
      "type": "object",
      "required": ["tag"],
      "oneOf": [
        {
          "properties": {
            "tag": {
              "enum": [
                "SBoolean", "SByte", "SShort", "SInt", "SLong", "SBigInt",
                "SUnsignedBigInt", "SGroupElement", "SSigmaProp", "SBox",
                "SHeader", "SPreHeader", "SUnit", "SAny", "SAvlTree"
              ]
            }
          },
          "required": ["tag"],
          "additionalProperties": false
        },
        {
          "properties": {
            "tag": { "const": "SColl" },
            "elem": { "$ref": "#/$defs/stype" }
          },
          "required": ["tag", "elem"],
          "additionalProperties": false
        },
        {
          "properties": {
            "tag": { "const": "SOption" },
            "elem": { "$ref": "#/$defs/stype" }
          },
          "required": ["tag", "elem"],
          "additionalProperties": false
        },
        {
          "properties": {
            "tag": { "const": "STuple" },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": { "$ref": "#/$defs/stype" }
            }
          },
          "required": ["tag", "items"],
          "additionalProperties": false
        }
      ]
    }
  }
}
