{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mwaddip/santa/schema/santa-nipopow.vector.schema.json",
  "title": "SANTA nipopow vector (santa-nipopow/v1)",
  "type": "object",
  "required": ["schema", "blessed_by", "chain", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "santa-nipopow/v1" },
    "blessed_by": { "type": "string", "minLength": 1 },
    "chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["height", "headerHex", "interlinks"],
        "additionalProperties": false,
        "properties": {
          "height": { "type": "integer", "minimum": 1 },
          "headerHex": { "$ref": "#/$defs/hex" },
          "interlinks": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/hex64" }
          }
        }
      }
    },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^([0-9a-f]{2})+$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entry": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["nipopow_interlinks", "nipopow_prove"] },
        "source": { "type": "string" },
        "payload": { "type": "object" },
        "expected": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "nipopow_prove" } }, "required": ["kind"] },
          "then": {
            "required": ["name", "kind", "source", "payload", "expected"],
            "properties": {
              "payload": {
                "type": "object",
                "required": ["m", "k", "headerId"],
                "additionalProperties": false,
                "properties": {
                  "m": { "type": "integer", "minimum": 1 },
                  "k": { "type": "integer", "minimum": 1 },
                  "headerId": { "anyOf": [{ "$ref": "#/$defs/hex64" }, { "type": "null" }] }
                }
              },
              "expected": {
                "type": "object",
                "required": ["proofHex"],
                "additionalProperties": false,
                "properties": {
                  "proofHex": { "$ref": "#/$defs/hex" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "nipopow_interlinks" } }, "required": ["kind"] },
          "then": {
            "required": ["name", "kind", "source", "expected"],
            "properties": {
              "expected": {
                "type": "object",
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  }
}
