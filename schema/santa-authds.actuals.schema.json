{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mwaddip/santa/schema/santa-authds.actuals.schema.json",
  "title": "SANTA authds actuals (santa-authds/v1)",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["error"],
    "properties": {
      "proofs": { "type": ["array", "null"], "items": { "type": "string" } },
      "digests": { "type": ["array", "null"], "items": { "type": "string" } },
      "proof_accepted": { "type": ["boolean", "null"] },
      "results": { "type": ["array", "null"] },
      "new_digest_hex": { "type": ["string", "null"] },
      "error": { "type": ["string", "null"] },
      "note": {}
    },
    "additionalProperties": false
  }
}
