{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mwaddip/santa/schema/santa-block.vector.schema.json",
  "title": "santa-block vector file",
  "type": "object",
  "required": ["schema", "op", "blessed_by", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "santa-block/v1" },
    "op": { "type": "string", "pattern": "^block:" },
    "blessed_by": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source", "parent_digest", "headers", "parameters",
                     "block", "boxes", "version", "expected"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "parent_digest": { "type": "string", "pattern": "^[0-9a-f]{66}$" },
          "headers": {
            "type": "array", "minItems": 0, "maxItems": 10,
            "items": { "type": "object" },
            "description": "preceding headers, newest-first, node-API JSON: the node's window below the block. A script sees the newest nine (CONTEXT.headers = the node's lastHeaders.drop(1) once the block's own header is in the window)."
          },
          "parameters": {
            "type": "object",
            "required": ["table"],
            "additionalProperties": false,
            "properties": {
              "table": {
                "type": "object",
                "additionalProperties": { "type": "integer" },
                "description": "in-force parametersTable, id(string)->value"
              }
            }
          },
          "block": {
            "type": "object",
            "required": ["header", "blockTransactions", "extension", "adProofs"],
            "properties": {
              "header": { "type": "object" },
              "blockTransactions": {
                "type": "string",
                "pattern": "^([0-9a-f]{2})+$",
                "minLength": 66,
                "description": "the transactions section as a node receives it, lowercase hex, framed as BlockTransactionsSerializer frames it: the 32-byte header id, the VLQ 10,000,000 + blockVersion marker above block version 1, the VLQ transaction count, the transactions. Bytes, not node-API JSON: a transaction's JSON re-writes its trees, so an as-received encoding cannot survive a runner that rebuilds the section through a writer"
              },
              "extension": { "type": "object" },
              "adProofs": {
                "type": "object",
                "required": ["proofBytes"],
                "properties": { "proofBytes": { "type": "string", "pattern": "^[0-9a-f]*$" } }
              }
            },
            "description": "the block: header, extension and adProofs as node-API JSON, blockTransactions as the section's bytes; adProofs non-null, with real proofBytes outside the proofless class"
          },
          "boxes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["boxId", "bytes"],
              "additionalProperties": false,
              "properties": {
                "boxId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "bytes": { "type": "string", "pattern": "^[0-9a-f]+$" }
              }
            },
            "description": "raw bytes of every external input/data-input box"
          },
          "version": {
            "type": "object",
            "required": ["activated", "ergoTree"],
            "additionalProperties": false,
            "properties": {
              "activated": { "type": "integer", "minimum": 0, "maximum": 127 },
              "ergoTree": { "type": "integer", "minimum": 0, "maximum": 127 }
            }
          },
          "expected": {
            "type": "object",
            "required": ["valid", "post_digest", "cost", "reason"],
            "additionalProperties": false,
            "properties": {
              "valid": { "type": "boolean" },
              "post_digest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{66}$" },
              "cost": { "type": ["integer", "null"], "minimum": 0 },
              "reason": { "type": ["string", "null"] }
            },
            "oneOf": [
              { "properties": { "valid": { "const": true },
                                "post_digest": { "type": "string" },
                                "cost": { "type": "integer" },
                                "reason": { "const": null } } },
              { "properties": { "valid": { "const": false },
                                "post_digest": { "const": null },
                                "cost": { "const": null },
                                "reason": { "type": "string" } } }
            ]
          }
        }
      }
    }
  },
  "$comment": "Empty proofBytes is legal ONLY in the proofless mutation class. The pattern above must stay '*' so the class is representable at all; non-emptiness is re-imposed below, keyed on the controlled `op` discriminator rather than on the free-text `source`.",
  "if": {
    "required": ["op"],
    "properties": { "op": { "const": "block:mutation:proofless" } }
  },
  "else": {
    "properties": {
      "entries": {
        "items": {
          "properties": {
            "block": {
              "properties": {
                "adProofs": {
                  "properties": {
                    "proofBytes": {
                      "minLength": 1,
                      "description": "non-empty outside the proofless class"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
