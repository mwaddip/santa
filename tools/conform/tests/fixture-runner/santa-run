#!/usr/bin/env bash
# A test-only self-contained runner for conform's tests (runner-integration §3/§4.3): it selects nothing itself.
#   santa-run <impl-path> <santa-dir> <out-dir>, with
#   FIXTURE_FILES  the relpaths (under vectors/) it answers, one per line
#   FIXTURE_MODE   honest  — answers every entry with its `expected`, reports no reds;
#                  lying   — the same, but reports one red record SANTA's re-grade does not see;
#                  partial — lists every file but writes actuals for the first only;
#                  silent  — writes nothing and exits 0.
# It records the SANTA commit only when <santa-dir> is the top of its checkout, compared literally, as a runner
# that follows the contract to the letter does (runner-integration §4.3).
set -euo pipefail
santa=$2 out=$3
[ "${FIXTURE_MODE:-honest}" = silent ] && exit 0
first=""
slices='{}'
while IFS= read -r rel; do
  [ -z "$rel" ] && continue
  if [ "${FIXTURE_MODE:-honest}" != partial ] || [ -z "$first" ]; then
    mkdir -p "$out/actuals/$(dirname "$rel")"
    jq '[.entries[] | {(.name): .expected}] | add' "$santa/vectors/$rel" > "$out/actuals/$rel"
  fi
  key=$(cut -d/ -f1-3 <<<"$rel")
  slices=$(jq --arg k "$key" --arg f "$rel" '.[$k] //= {files: [], dims: {}, not_implemented: 0, panicked: 0, exceeded: 0, red: []}
                                             | .[$k].files += [$f]' <<<"$slices")
  [ -z "$first" ] && first=$rel
done <<<"$FIXTURE_FILES"
reds=0
if [ "${FIXTURE_MODE:-honest}" = lying ]; then
  entry=$(jq -r '.entries[0].name' "$santa/vectors/$first")
  key=$(cut -d/ -f1-3 <<<"$first")
  slices=$(jq --arg k "$key" --arg f "$first" --arg e "$entry" \
    '.[$k].red += [{file: $f, entry: $e, dim: "value", expected: "-", got: "-"}]' <<<"$slices")
  reds=1
fi
if [ "$(git -C "$santa" rev-parse --show-toplevel)" = "$santa" ]; then commit=$(git -C "$santa" rev-parse HEAD); else commit=null; fi
jq -n --arg santa "$commit" --argjson slices "$slices" --argjson reds "$reds" \
  '{schema: "santa-runner-results/v1", santa: (if $santa == "null" then null else $santa end), scope: {version: "v6", tiers: ["eval"], cost: true},
    slices: $slices, totals: {red: $reds, not_implemented: 0}}' > "$out/results.json"
