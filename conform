#!/usr/bin/env bash
# SANTA conformance orchestrator. Self-provisions SANTA's own toolchain (rust, via tools/mise.toml)
# the same way each runner self-provisions, then builds + runs the Rust `conform`. mise + git are the
# only bootstrap deps; runners self-provide their languages. (Replaces the former python conform.py.)
# Distinct guard var from the runners' SANTA_MISE_ACTIVE, so conform's spawned santa-runs still
# self-provision their own toolchains.
set -euo pipefail
d="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${SANTA_TOOLS_MISE:-}" ]; then
  mise trust "$d/tools/mise.toml" >/dev/null
  mise --cd "$d/tools" install
  # Re-exec under the tools' mise. Use an ABSOLUTE self-path: `mise --cd` changes the
  # command's cwd to tools/, so a relative "$0" (e.g. ./conform) would resolve to
  # tools/conform and fail ("couldn't exec process: Permission denied").
  exec env SANTA_TOOLS_MISE=1 mise --cd "$d/tools" exec -- "$d/$(basename "$0")" "$@"
fi
exec cargo run --manifest-path "$d/tools/Cargo.toml" -p conform -q -- "$@"
